# Copy to .env (never commit it) or set these in your host's dashboard.

# --- Claude -------------------------------------------------------------
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium            # low | medium | high

# --- WhatsApp Cloud API (Meta) -------------------------------------------
WHATSAPP_TOKEN=                    # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=          # from WhatsApp > API Setup
WHATSAPP_APP_SECRET=               # App settings > Basic > App secret (verifies webhooks)
WHATSAPP_VERIFY_TOKEN=             # any random string; paste the same into the Meta webhook form
# WHATSAPP_API_VERSION=v24.0
# WA_TEMPLATE_INTRO=repocket_intro
# WA_TEMPLATE_FOLLOWUP=repocket_followup
# WA_TEMPLATE_OWNER_ALERT=tradedesk_alert
# WA_TEMPLATE_LANG=en

# --- You -------------------------------------------------------------------
OWNER_WHATSAPP=                    # your own WhatsApp number, e.g. +44 7…  (drafts & alerts go here)
# OWNER_NAME=Deepak

# --- Behaviour -------------------------------------------------------------
MODE=approve                       # approve = every reply is a draft; auto = safe replies go out
# AI_DISCLOSURE=true               # in auto mode, first unreviewed message says it's Deepak's assistant
# DEBOUNCE_SECONDS=20              # wait for a pause before replying to a burst of messages
# FOLLOWUP_DAYS=3,7,14
# OUTREACH_DAILY_LIMIT=30
# SEND_WINDOW_UTC=7-17             # outreach & follow-ups only Mon-Fri in this UTC hour range
# DIGEST_HOUR_UTC=7

# --- Trading economics (editable later in Settings) -----------------------
# BASE_CURRENCY=EUR
# FX_RATES=GBP=1.17,USD=0.92,AED=0.25
# TARGET_MARGIN_PCT=8
# COST_PER_UNIT=3
# COST_PCT=1.5

# --- App ---------------------------------------------------------------------
DASHBOARD_PASSWORD=                # login: user "deepak" + this password
# DASHBOARD_USER=deepak
# DATABASE_PATH=data/tradedesk.db
# PLAYBOOK_PATH=/data/playbook.md  # keep a private playbook off GitHub
# DEV_MODE=false                   # true = no login/signature checks (local testing only)
